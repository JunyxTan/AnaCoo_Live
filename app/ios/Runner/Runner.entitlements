<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared with the Share Extension, which drops the shared message here
	     before opening the app. Keep this identical in both targets. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.anacoo.anacooTailor</string>
	</array>
</dict>
</plist>
